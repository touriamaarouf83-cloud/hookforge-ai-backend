
import { timingSafeEqual } from "node:crypto";

const GROQ_URL = "https://api.groq.com/openai/v1/chat/completions";
const DEFAULT_MODEL = "openai/gpt-oss-20b";
const TIMEOUT_MS = 20000;

function isAuthorized(req) {
  const expected = process.env.GROQ_TEST_SECRET;
  const received = req.headers["x-test-secret"];

  if (!expected || typeof received !== "string") return false;

  const a = Buffer.from(expected);
  const b = Buffer.from(received);

  return a.length === b.length && timingSafeEqual(a, b);
}

function getKeys() {
  return Array.from({ length: 6 }, (_, i) => ({
    slot: i + 1,
    key: process.env[`GROQ_API_KEY_${i + 1}`]
  })).filter(item =>
    typeof item.key === "string" && item.key.trim()
  );
}

async function testKey(key, model) {
  const controller = new AbortController();
  const timeout = setTimeout(
    () => controller.abort(),
    TIMEOUT_MS
  );

  const started = Date.now();

  try {
    const response = await fetch(GROQ_URL, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        Authorization: `Bearer ${key}`
      },
      body: JSON.stringify({
        model,
        messages: [
          {
            role: "user",
            content: "Reply with exactly: OK"
          }
        ],
        temperature: 0,
        max_tokens: 10
      }),
      signal: controller.signal
    });

    const data = await response.json().catch(() => ({}));

    return {
      success: response.ok &&
        Boolean(data?.choices?.[0]?.message?.content),
      status: response.status,
      model: data.model || model,
      latencyMs: Date.now() - started,
      error: response.ok
        ? null
        : data?.error?.message || "Groq request failed."
    };

  } catch (error) {
    return {
      success: false,
      status: error.name === "AbortError" ? 504 : 502,
      model,
      latencyMs: Date.now() - started,
      error: error.name === "AbortError"
        ? "Request timed out."
        : "Network error."
    };
  } finally {
    clearTimeout(timeout);
  }
}

export default async function handler(req, res) {
  res.setHeader("Cache-Control", "no-store");

  if (req.method !== "POST") {
    return res.status(405).json({
      success: false,
      error: "POST method required."
    });
  }

  if (!isAuthorized(req)) {
    return res.status(401).json({
      success: false,
      error: "Unauthorized."
    });
  }

  const keys = getKeys();
  const model = process.env.GROQ_MODEL || DEFAULT_MODEL;

  if (!keys.length) {
    return res.status(503).json({
      success: false,
      error: "No Groq API keys configured."
    });
  }

  const results = [];

  // Test each configured key separately.
  for (const item of keys) {
    const result = await testKey(item.key, model);

    results.push({
      keySlot: item.slot,
      configured: true,
      ...result
    });
  }

  const passed = results.filter(item => item.success).length;

  return res.status(200).json({
    success: passed === results.length,
    model,
    totalConfigured: keys.length,
    passed,
    failed: results.length - passed,
    results
  });
}
